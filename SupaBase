-- 7. GENERATE 50 SLOTS FOR EACH LOCATION

INSERT INTO public.parking_slots (lot_id, slot_code)

SELECT
    l.id,
    CHR(65 + r.row_number) || s.slot_number

FROM public.lots l

CROSS JOIN GENERATE_SERIES(0, 4)
    AS r(row_number)

CROSS JOIN GENERATE_SERIES(1, 10)
    AS s(slot_number)

ON CONFLICT (lot_id, slot_code) DO NOTHING;

























-- Check all five parking locations
SELECT *
FROM public.lots
ORDER BY display_order;

-- Count total parking slots
SELECT COUNT(*) AS total_slots
FROM public.parking_slots;

-- Count slots in each parking location
SELECT
    l.name,
    COUNT(s.id) AS total_slots
FROM public.lots l
LEFT JOIN public.parking_slots s
    ON l.id = s.lot_id
GROUP BY l.name, l.display_order
ORDER BY l.display_order;

