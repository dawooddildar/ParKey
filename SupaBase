
-- =========================================
-- PARKEY DATABASE SETUP
-- =========================================

-- 1. PARKING LOCATIONS
CREATE TABLE public.lots (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    name TEXT UNIQUE NOT NULL,
    slug TEXT UNIQUE NOT NULL,
    display_order INTEGER NOT NULL,
    created_at TIMESTAMPTZ DEFAULT NOW()
);


-- 2. PARKING SLOTS
CREATE TABLE public.parking_slots (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    lot_id UUID NOT NULL
        REFERENCES public.lots(id) ON DELETE RESTRICT,

    slot_code TEXT NOT NULL,

    status TEXT NOT NULL DEFAULT 'free'
        CHECK (status IN ('free', 'held', 'parked')),

    current_driver_id UUID
        REFERENCES auth.users(id),

    reservation_type TEXT
        CHECK (reservation_type IN ('immediate', 'advance')),

    hold_expires_at TIMESTAMPTZ,

    parked_since TIMESTAMPTZ,

    created_at TIMESTAMPTZ DEFAULT NOW(),

    UNIQUE (lot_id, slot_code),

    -- Keep slot ownership and timestamps consistent
    CHECK (
        (status = 'free'
            AND current_driver_id IS NULL
            AND reservation_type IS NULL
            AND hold_expires_at IS NULL
            AND parked_since IS NULL)

        OR

        (status = 'held'
            AND current_driver_id IS NOT NULL
            AND reservation_type IS NOT NULL
            AND hold_expires_at IS NOT NULL
            AND parked_since IS NULL)

        OR

        (status = 'parked'
            AND current_driver_id IS NOT NULL
            AND reservation_type IS NOT NULL
            AND hold_expires_at IS NULL
            AND parked_since IS NOT NULL)
    )
);


-- 3. RESERVATION HISTORY
CREATE TABLE public.reservations (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    slot_id UUID NOT NULL
        REFERENCES public.parking_slots(id) ON DELETE RESTRICT,

    driver_id UUID
        REFERENCES auth.users(id) ON DELETE SET NULL,

    reservation_type TEXT NOT NULL
        CHECK (reservation_type IN ('immediate', 'advance')),

    status TEXT NOT NULL DEFAULT 'held'
        CHECK (status IN ('held', 'parked', 'released', 'expired')),

    reserved_at TIMESTAMPTZ DEFAULT NOW(),

    hold_expires_at TIMESTAMPTZ,

    parked_at TIMESTAMPTZ,

    released_at TIMESTAMPTZ
);


-- 4. PREVENT DUPLICATE ACTIVE RESERVATIONS

-- One active reservation per parking slot
CREATE UNIQUE INDEX one_active_reservation_per_slot
ON public.reservations (slot_id)
WHERE status IN ('held', 'parked');

-- One active reservation per driver
CREATE UNIQUE INDEX one_active_reservation_per_driver
ON public.reservations (driver_id)
WHERE status IN ('held', 'parked')
AND driver_id IS NOT NULL;


-- 5. ENABLE ROW LEVEL SECURITY

ALTER TABLE public.lots
ENABLE ROW LEVEL SECURITY;

ALTER TABLE public.parking_slots
ENABLE ROW LEVEL SECURITY;

ALTER TABLE public.reservations
ENABLE ROW LEVEL SECURITY;


